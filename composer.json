{
    "name": "hgabka/media-bundle",
    "type": "symfony-bundle",
    "description": "Media bundle",
    "keywords": [],
    "homepage": "https://github.com/hgabka/media-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Gabe",
            "email": "hgabka@gmail.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/logger-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/node-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/settings-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/utils-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/seo-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/doctrine-translatable.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/doctrine-translatable-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/email-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/simple-content-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/i18n-routing-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/acl-bundle.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/security-acl.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:hgabka/pagepart-bundle.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^3.7",
        "hgabka/utils-bundle": "^7.1|^8.0",
        "liip/imagine-bundle": "^2.1",
        "knplabs/gaufrette": "^0.10",
        "symfony/framework-bundle": "^7.0|^8.0",
        "twig/intl-extra": "^3.3"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.11|^3.0",
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "gedmo/doctrine-extensions": "^3.0",
        "hgabka/acl-bundle": "^7.1|^8.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0",
        "symfony/security-acl": "^7.1|^8.0",
        "symfony/validator": "^7.0|^8.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Hgabka\\MediaBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hgabka\\MediaBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev",
            "dev-v8": "8.0.x-dev"
        }
    }
}
